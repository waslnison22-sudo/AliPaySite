# ===== AliPaySite — переменные окружения =====
# Скопируйте этот файл в .env и заполните реальными значениями
# при подключении боевого эквайринга. НИКОГДА не коммитьте .env в git.

# Режим работы платёжного модуля:
#   stub    — аккуратная заглушка (по умолчанию, без реальных списаний)
#   yookassa — ЮKassa (Россия/СНГ): https://yookassa.ru/developers
#   stripe  — Stripe (международные платежи): https://stripe.com/docs
PAYMENT_PROVIDER=stub

# --- ЮKassa ---
# Server API key (секретный ключ, используется ТОЛЬКО на бэкенде)
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=

# --- Stripe ---
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=

# Валюта по умолчанию
PAYMENT_CURRENCY=RUB
