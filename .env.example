# Скопируйте в .env и заполните. Файл .env в git не попадает.

# Активный платёжный провайдер: contact (заглушка, ссылка на мастера) | platega
VITE_PAYMENT_PROVIDER=contact

# Бэкенд-эндпоинт создания платежа Platega (когда включите platega):
# принимает POST {amount, currency, orderId, description}
# и возвращает { paymentUrl } из Platega API.
VITE_PAYMENT_API=

# !!! Merchant Login / Password Platega хранятся ТОЛЬКО на бэкенде,
# !!! никогда в этом файле фронтенда и не в репозитории.
